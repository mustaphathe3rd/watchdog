# =============================================================================
# .env.example  —  Environment Variables Template
# =============================================================================
# COPY this file to .env and fill in your values:
#   cp .env.example .env
#
# NEVER commit .env to Git. Add it to .gitignore.
# =============================================================================

# PostgreSQL connection string (NFR-04 production database)
DATABASE_URL=postgresql://watchdog_user:watchdog_pass@localhost:5432/naija_watchdog

# FOR TESTING WITHOUT POSTGRESQL (SQLite — simpler, no install required):
# DATABASE_URL=sqlite:///naija_watchdog_test.db

# Flask admin dashboard secret key (change to a random string in production)
FLASK_SECRET_KEY=your-random-secret-key-here

# Set to True during development to enable Flask debugger
FLASK_DEBUG=False

# ── yt-dlp authentication for Facebook/Instagram (optional) ──────────────────
# Facebook and Instagram block anonymous video downloads. Pick ONE option:
#
# Option 1 (easiest): pull cookies live from a browser you're logged into.
# YTDLP_COOKIES_FROM_BROWSER=chrome
#
# Option 2: point at a manually-exported cookies.txt (Netscape format), e.g.
# via the "Get cookies.txt LOCALLY" extension. NEVER commit this file.
# YTDLP_COOKIES_FILE=cookies.txt
